{
  "manifest_version": 3,
  "name": "LiteProxy",
  "version": "2.3.0",
  "description": "为 Chrome 设置全局代理 · 轻量、克制、小而美",
  "permissions": ["proxy", "storage", "contextMenus", "notifications"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "/public/icons/icon16.png",
      "48": "/public/icons/icon48.png",
      "128": "/public/icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-extension": {
      "description": "切换 LiteProxy 代理开关"
    }
  },
  "icons": {
    "16": "/public/icons/icon16.png",
    "48": "/public/icons/icon48.png",
    "128": "/public/icons/icon128.png"
  }
}
