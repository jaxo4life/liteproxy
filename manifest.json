{
  "manifest_version": 3,
  "name": "简单全局代理",
  "version": "2.2.0",
  "description": "为Chrome设置全局代理",
  "permissions": ["proxy", "storage", "tabs", "contextMenus", "notifications"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["settings.html", "bypass.json"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "toggle-extension": {
      "description": "切换LiteProxy开关状态"
    }
  },
  "icons": {
    "128": "/public/logo.png"
  }
}
